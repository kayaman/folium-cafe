{
  "id": "/",
  "lang": "en",
  "dir": "ltr",
  "name": "Folium Café",
  "short_name": "Folium",
  "description": "A private reading café — so you remember the page you were on.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "launch_handler": { "client_mode": "navigate-existing" },
  "theme_color": "#5e261d",
  "background_color": "#efe6d2",
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/crest-mono.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "monochrome" }
  ],
  "shortcuts": [
    {
      "name": "Continue reading",
      "short_name": "Continue",
      "url": "/?continue=1",
      "icons": [{ "src": "/icons/shortcut-continue.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "pdfs",
          "accept": [
            "application/pdf", ".pdf",
            "application/epub+zip", ".epub",
            "application/vnd.comicbook+zip", ".cbz",
            "text/plain", ".txt",
            "text/markdown", ".md"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/pdf": [".pdf"],
        "application/epub+zip": [".epub"],
        "application/vnd.comicbook+zip": [".cbz"],
        "text/plain": [".txt"],
        "text/markdown": [".md"]
      }
    }
  ]
}
